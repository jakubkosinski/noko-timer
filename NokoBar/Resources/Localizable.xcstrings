  "strings": {
    "error.unauthorized": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid or expired token. Please log in again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowy lub wygasły token. Zaloguj się ponownie."
          }
        }
      }
    },
    "error.notFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not found."
          }
        },
